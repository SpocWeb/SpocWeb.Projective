    <Compile Remove="typed\Point3D.T.cs" />
    <Compile Remove="typed\Point3Dbl.T.cs" />
    <Compile Remove="typed\Point4D.T.cs" />
    <Compile Remove="typed\Point4Dbl.T.cs" />
